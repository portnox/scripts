[Unit]
Description=Portnox MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portnox
Group=portnox
WorkingDirectory=/opt/portnox-mcp
Environment=PORTNOX_BASE_URL=https://clear.portnox.com:8081/CloudPortalBackEnd
Environment=PORTNOX_TOKEN=REPLACE_WITH_LONG_LIVED_TOKEN
Environment=PORTNOX_TIMEOUT_SECONDS=30
Environment=PORTNOX_VERIFY_TLS=true
ExecStart=/opt/portnox-mcp/.venv/bin/python /opt/portnox-mcp/MCP\ Server.py --log-level INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
